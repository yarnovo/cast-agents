# <AGENT_NAME> · production env (FC v3 函数环境变量自动注入)
#
# 真 env 不入 git · 走 vault.json 声明 · vault install 生成 .vault/secrets.json
# GHA 跑 ZIP deploy 时从 secrets 拼成 fc PUT body 的 environmentVariables 字段

# ─── LLM ─────────────────────────────────────────────
DASHSCOPE_API_KEY=                       # vault: dashscope-main · 阿里百炼 (deepseek-v4-pro/flash · 通义)

# ─── akong-agent-base 通用 ───────────────────────────
AGENT_MASTER_KEY=                        # 32 字节 base64 url-safe · vault: <agent>.master_key (Fernet 加密 user 凭证)
# AGENT_NAS_ROOT=/mnt/nas/<agent>        # default · agent sqlite 路径 (NAS 挂载)
# AGENT_DB_NAME=<agent>.sqlite           # default

# ─── 数据 (default sqlite NAS · 大量并发改 RDS) ──────
# RDS_HOST=                              # 选用: 共享 hongniang-rds-mysql.endpoint_internal
# RDS_PORT=3306
# RDS_DB=<AGENT_NAME>_prod
# RDS_USER=<AGENT_NAME>_prod_user
# RDS_PASSWORD=                          # vault: hongniang-rds-mysql.<agent>_prod_password

# ─── OSS (用户文件 · 共享 fc-zips 装代码 · 业务 bucket 各仓自管) ─
OSS_ACCESS_KEY_ID=                       # vault: aliyun-main / RAM 子号
OSS_ACCESS_KEY_SECRET=
# OSS_ENDPOINT=oss-cn-hangzhou-internal.aliyuncs.com  # FC 走 VPC 内网

# ─── 部署元信息 ─────────────────────────────────────
ENV_NAME=prod                            # GHA 自动设 prod / staging
AGENT_NAME=<AGENT_NAME>
SUBDOMAIN=<SUBDOMAIN>                    # 例: dayou.mail · 用于 api.<SUBDOMAIN>.agentaily.com
